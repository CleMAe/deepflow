# Database — dev default is SQLite; production uses PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./deepflow.db
DATABASE_URL_SYNC=sqlite:///./deepflow.db

# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://deepflow:deepflow@localhost:5432/deepflow
# DATABASE_URL_SYNC=postgresql+psycopg2://deepflow:deepflow@localhost:5432/deepflow
