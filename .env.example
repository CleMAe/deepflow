# Database — sync SQLAlchemy URL (SQLite dev / PostgreSQL prod)
DATABASE_URL=sqlite:///./deepflow.db

# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://deepflow:deepflow@localhost:5432/deepflow

# DeepFlow Docker Compose environment (copy to .env)

POSTGRES_USER=deepflow
POSTGRES_PASSWORD=deepflow
POSTGRES_DB=deepflow
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=8080

JWT_SECRET=change-me-in-production

# Frontend local integration (copy frontend/.env.example to frontend/.env)
VITE_API_BASE_URL=/api/v1
VITE_ENABLE_MSW=true

# GPU profile (gpu-train service)
NVIDIA_VISIBLE_DEVICES=all
